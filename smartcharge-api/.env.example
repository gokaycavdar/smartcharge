# Backend Development Environment Variables
# Copy this file to .env when developing locally with go run

# PostgreSQL Database
DATABASE_URL=postgres://admin:admin@localhost:5432/evcharge?sslmode=disable

# JWT Secret (keep this dev-only, use strong secret in production)
JWT_SECRET=your-jwt-secret-here

# Server Configuration
PORT=8080
GIN_MODE=debug
FRONTEND_URL=http://localhost:3000

# Google Gemini API (Required for Chat)
# Get API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
